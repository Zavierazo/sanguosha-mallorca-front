# Copia este fichero a .env y rellena los valores.
#
# Todas las variables VITE_* acaban en el bundle del navegador y son por tanto
# publicas. No anadir aqui ningun secreto: ni la service_role key de Supabase,
# ni la contrasena de Postgres, ni client secrets de OAuth.

# Proyecto de Supabase, que es la unica fuente de datos de la web. La clave
# publicable (sb_publishable_...) es de solo lectura por si misma; escribir exige
# sesion de Google mas estar en la lista de organizadores (jugadores.email).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
