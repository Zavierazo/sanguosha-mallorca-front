VITE_GOOGLE_SHEET_NAME=Games

# Vite mete en el bundle del navegador todo lo que empiece por VITE_, asi que
# estos dos valores son publicos por diseno y no hay nada que rotar. La clave
# publishable no da acceso a nada: lo que protege los datos es el row level
# security del proyecto (lectura para todos, INSERT solo para organizadores,
# UPDATE y DELETE para nadie).
#
# NO anadir aqui ninguna clave secreta: este fichero esta commiteado en un repo
# publico y ademas no esta en .gitignore.
VITE_SUPABASE_URL=https://ewfyranlaxhxhcrtgymp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_mH5zv24gXoSW5pxWBIplnA_zF0gto5w

# De donde lee la web: "supabase" o "sheets".
#
# La hoja de Google era una copia periodica de la base de datos, necesaria solo
# porque el servidor de Azure estaba apagado casi siempre. Con los datos en
# Supabase la copia sobra, pero se deja como vuelta atras.
#
# Esto es solo el valor por defecto. Para forzar una fuente sin desplegar, en la
# URL: ?datos=sheets  /  ?datos=supabase  /  ?datos=auto para olvidarlo.
# Y si la fuente activa falla, se recurre a la otra automaticamente.
VITE_DATA_SOURCE=supabase
